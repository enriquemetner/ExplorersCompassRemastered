{
  "default": "lockedUntilVisitedSet",
  "rules": {
    "visit_any": {
      "unlocks": [
        "minecraft:ancient_city"
      ],
      "condition": {
        "type": "visit",
        "match": "any",
        "structures": [
          "minecraft:villages",
          "minecraft:pillager_outpost"
        ]
      }
    },
    "visit_all": {
      "unlocks": [
        "minecraft:desert_pyramid"
      ],
      "condition": {
        "type": "visit",
        "match": "any",
        "structures": [
          "minecraft:ancient_city",
          "minecraft:strongholds"
        ]
      }
    },
    "advancement_any": {
      "unlocks": [
        "minecraft:nether_complexes"
      ],
      "condition": {
        "type": "advancement",
        "match": "any",
        "advancements": [
          "minecraft:story/enter_the_nether",
          "minecraft:story/mine_diamond"
        ]
      }
    },
    "advancement_all": {
      "unlocks": [
        "minecraft:village_*"
      ],
      "condition": {
        "type": "advancement",
        "match": "all",
        "advancements": [
          "minecraft:story/mine_stone",
          "minecraft:story/smelt_iron"
        ]
      }
    },
    "visit_default_match": {
      "unlocks": [
        "minecraft:shipwreck"
      ],
      "condition": {
        "type": "visit",
        "structures": [
          "fortress",
          "minecraft:ocean_ruin_*"
        ]
      }
    }
  }
}
