{
  "schemaVersion": 1,
  "id": "explorerscompass",
  "version": "${version}",

  "name": "Explorer's Compass: Remastered",
  "description": "Locate structures anywhere in the world.\nThe remastered version improves basically everything from the original mod and adds a ton of features.",
  "authors": [
    "EnrikiMufasa",
    "ChaosTheDude"
  ],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/explorers-compass",
    "issues": "https://github.com/enriquemetner/ExplorersCompassRemastered/issues"
  },

  "license": "CC BY-NC-SA 4.0",
  "icon": "assets/explorerscompass/icon.png",

  "environment": "*",
  "entrypoints": {
    "main": [
      "io.github.enriquemetner.explorerscompass.ExplorersCompass"
    ],
    "modmenu": [
      "io.github.enriquemetner.explorerscompass.compat.modmenu.CompassModMenu"
    ],
    "client": [
      "io.github.enriquemetner.explorerscompass.ExplorersCompassClient"
    ]
  },
  "custom": {
    "modmenu": {
      "links": {
        "explorerscompass.modmenu.video_trailer": "https://www.youtube.com/",
        "explorerscompass.modmenu.video_showcase": "https://www.youtube.com/",
        "explorerscompass.modmenu.wiki": "https://github.com/enriquemetner/ExplorersCompassRemastered/wiki"
      }
    }
  },
  "mixins": [
    "explorerscompass.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.14.21",
    "fabric": "*",
    "minecraft": "~1.20",
    "java": ">=17"
  },
  "suggests": {
    "modmenu": "*",
    "naturescompass": "*",
    "ftbquests": "*",
    "openpartiesandclaims": "*"
  }
}
